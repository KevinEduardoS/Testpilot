# Core
NODE_ENV=development
API_PORT=3001
RUNNER_PORT=3002
RUNNER_URL=http://localhost:3002
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://testpilot:testpilot@postgres:5432/testpilot

# Secrets
ANTHROPIC_API_KEY=
# claude-opus-5-5 (por defecto), claude-sonnet-5-5 (más barato), claude-opus-5 o claude-fable-5-1
ANTHROPIC_MODEL=claude-opus-5-5
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Runtime settings
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_MAX_TOKENS=16000
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=120000
RUN_TIMEOUT_MS=60000
RATE_LIMIT_PER_HOUR=10
SNAPSHOT_MAX_CHARS=40000

# Frontend
VITE_API_URL=http://localhost:3001
